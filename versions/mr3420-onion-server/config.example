# =============================================================================
# config.example — Plantilla de configuracion del proyecto mr3420-onion-server
# =============================================================================
# Copiar a "config", completar los valores reales y limitar permisos:
#   cp config.example config && chmod 600 config
#
# "config" NO se versiona (ver .gitignore). No incluir secretos en este archivo.
# Los scripts leen este archivo con "source"; usar valores sin espacios ni comillas.
# =============================================================================

# --- Router -----------------------------------------------------------------
ROUTER_IP=192.168.1.1
ROUTER_USER=root
# Contrasena de root del router (generar en runtime, minimo 16 caracteres)
ROOT_PASSWORD=[REDACTED]

# --- Interfaces del router (OpenWrt) ----------------------------------------
WAN_IFACE=wan
LAN_IFACE=br-lan

# --- Servicio onion ---------------------------------------------------------
LOCAL_SERVICE_IP=127.0.0.1
LOCAL_SERVICE_PORT=8080
ONION_PORT=80
HIDDEN_SERVICE_DIR=/etc/tor/hidden_service
# Se completa automaticamente en la fase 04
ONION_ADDRESS=

# --- Wi-Fi AP de gestion ----------------------------------------------------
WIFI_SSID=MR3420-Onion-2G
# Clave WPA2 (generar en runtime, 16-63 caracteres)
WIFI_KEY=[REDACTED]

# --- Notebook de trabajo ----------------------------------------------------
NOTEBOOK_IFACE=enp0s31f6
NOTEBOOK_TFTP_IP=192.168.0.225
ORIGINAL_NM_PROFILE=netplan-enp0s31f6
TEMP_DISC_PROFILE=mr3420-disc
TEMP_TFTP_PROFILE=mr3420-tftp

# --- Firmware OpenWrt (TFTP recovery) ---------------------------------------
TFTP_FILENAME=tp_recovery.bin
FIRMWARE_URL=https://downloads.openwrt.org/releases/24.10.8/targets/ramips/mt76x8/openwrt-24.10.8-ramips-mt76x8-tplink_tl-mr3420-v5-squashfs-tftp-recovery.bin
FIRMWARE_SHA256=5c570a0ce44c907e6bdb7715cf54ba09b2c263ec45c28d6e069447e353750a2b
