#!/bin/sh /etc/rc.common
START=10
USE_PROCD=1

start() {
    # MR3420 v5: el LED del puerto LAN4 comparte GPIO con la alimentacion USB.
    # Aplicar SIEMPRE el modo 11 para mantener el USB alimentado, incluso
    # cuando el overlay ya esta montado desde el pendrive (extroot).
    swconfig dev switch0 port 4 set led 11 2>/dev/null
    swconfig dev switch0 set apply 2>/dev/null

    # Si el overlay ya esta montado desde USB, NO tocar el EHCI:
    # un unbind/bind desconectaria el disco de arranque.
    if [ -b /dev/sda1 ] && mount | grep -q ' /overlay '; then
        exit 0
    fi

    # Sin extroot: forzar re-enumeracion del bus USB.
    if [ -e /sys/bus/platform/drivers/ehci-platform/unbind ]; then
        echo 101c0000.ehci > /sys/bus/platform/drivers/ehci-platform/unbind 2>/dev/null
        sleep 1
        echo 101c0000.ehci > /sys/bus/platform/drivers/ehci-platform/bind 2>/dev/null
    fi

    # Esperar hasta 10 s a que aparezca la particion USB.
    i=0
    while [ $i -lt 10 ]; do
        if ls /dev/sd*1 >/dev/null 2>&1; then
            break
        fi
        sleep 1
        i=$((i+1))
    done
}
