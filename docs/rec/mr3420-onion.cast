[55.792, "o", "\u001b[90m┌─ usbpower · init script de OpenWrt ───────────────────────────────────────────────────────────────────\u001b[0m\n"]
[55.792, "o", "\u001b[90m   1\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#!/bin/sh /etc/rc.common\u001b[39;49;00m\n"]
[55.847, "o", "\u001b[90m   2\u001b[0m\u001b[90m │ \u001b[0m\u001b[91mSTART\u001b[39;49;00m=\u001b[94m10\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[55.902, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[91mUSE_PROCD\u001b[39;49;00m=\u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[55.957, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[56.012, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0mstart()\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[56.067, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m# MR3420 v5: el LED del puerto LAN4 comparte GPIO con la alimentacion USB.\u001b[39;49;00m\n"]
[56.122, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m# Aplicar SIEMPRE el modo 11 para mantener el USB alimentado, incluso\u001b[39;49;00m\n"]
[56.177, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m# cuando el overlay ya esta montado desde el pendrive (extroot).\u001b[39;49;00m\n"]
[56.232, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mswconfig\u001b[90m \u001b[39;49;00mdev\u001b[90m \u001b[39;49;00mswitch0\u001b[90m \u001b[39;49;00mport\u001b[90m \u001b[39;49;00m\u001b[94m4\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[96mset\u001b[39;49;00m\u001b[90m \u001b[39;49;00mled\u001b[90m \u001b[39;49;00m\u001b[94m11\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94m2\u001b[39;49;00m>/dev/null\u001b[90m\u001b[39;49;00m\n"]
[56.287, "o", "\u001b[90m  10\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mswconfig\u001b[90m \u001b[39;49;00mdev\u001b[90m \u001b[39;49;00mswitch0\u001b[90m \u001b[39;49;00m\u001b[96mset\u001b[39;49;00m\u001b[90m \u001b[39;49;00mapply\u001b[90m \u001b[39;49;00m\u001b[94m2\u001b[39;49;00m>/dev/null\u001b[90m\u001b[39;49;00m\n"]
[56.342, "o", "\u001b[90m  11\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[56.397, "o", "\u001b[90m  12\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m# Si el overlay ya esta montado desde USB, NO tocar el EHCI:\u001b[39;49;00m\n"]
[56.452, "o", "\u001b[90m  13\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m# un unbind/bind desconectaria el disco de arranque.\u001b[39;49;00m\n"]
[56.507, "o", "\u001b[90m  14\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m[\u001b[90m \u001b[39;49;00m-b\u001b[90m \u001b[39;49;00m/dev/sda1\u001b[90m \u001b[39;49;00m]\u001b[90m \u001b[39;49;00m&&\u001b[90m \u001b[39;49;00mmount\u001b[90m \u001b[39;49;00m|\u001b[90m \u001b[39;49;00mgrep\u001b[90m \u001b[39;49;00m-q\u001b[90m \u001b[39;49;00m\u001b[33m' /overlay '\u001b[39;49;00m;\u001b[90m \u001b[39;49;00m\u001b[94mthen\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[56.562, "o", "\u001b[90m  15\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[96mexit\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[56.617, "o", "\u001b[90m  16\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mfi\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[56.672, "o", "\u001b[90m  17\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
