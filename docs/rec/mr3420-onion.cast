[88.675, "o", "\u001b[90m┌─ torrc.example · hidden service ──────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[88.675, "o", "\u001b[90m  12\u001b[0m\u001b[90m │ \u001b[0m# Directorio persistente del hidden service (clave privada + hostname)\n"]
[88.73, "o", "\u001b[90m  13\u001b[0m\u001b[90m │ \u001b[0mHiddenServiceDir /etc/tor/hidden_service\n"]
[88.785, "o", "\u001b[90m  14\u001b[0m\u001b[90m │ \u001b[0m\n"]
[88.84, "o", "\u001b[90m  15\u001b[0m\u001b[90m │ \u001b[0m# Servicio oculto version 3 (formato actual de la red Tor)\n"]
[88.895, "o", "\u001b[90m  16\u001b[0m\u001b[90m │ \u001b[0mHiddenServiceVersion 3\n"]
[88.95, "o", "\u001b[90m  17\u001b[0m\u001b[90m │ \u001b[0m\n"]
[89.005, "o", "\u001b[90m  18\u001b[0m\u001b[90m │ \u001b[0m# Publica el servicio local en onion:80 -> uhttpd en loopback:8080\n"]
[89.06, "o", "\u001b[90m  19\u001b[0m\u001b[90m │ \u001b[0mHiddenServicePort 80 127.0.0.1:8080\n"]
