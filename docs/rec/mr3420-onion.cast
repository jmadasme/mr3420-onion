[41.608, "o", "\u001b[90m┌─ 01_download_firmware.sh · objetivo ──────────────────────────────────────────────────────────────────\u001b[0m\n"]
[41.608, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# =============================================================================\u001b[39;49;00m\n"]
[41.663, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# 01_download_firmware.sh — Descarga y verificacion de la imagen OpenWrt\u001b[39;49;00m\n"]
[41.718, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# =============================================================================\u001b[39;49;00m\n"]
[41.773, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Descarga la imagen oficial de OpenWrt 24.10.8 para el TL-MR3420 v5,\u001b[39;49;00m\n"]
[41.828, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# verifica SHA256 y tamano, y crea la copia firmware/tp_recovery.bin que\u001b[39;49;00m\n"]
[41.883, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# espera el bootloader U-Boot por TFTP.\u001b[39;49;00m\n"]
[41.938, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#\u001b[39;49;00m\n"]
[41.993, "o", "\u001b[90m  10\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Uso:\u001b[39;49;00m\n"]
[42.048, "o", "\u001b[90m  11\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   ./scripts/01_download_firmware.sh\u001b[39;49;00m\n"]
[42.103, "o", "\u001b[90m  12\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#\u001b[39;49;00m\n"]
[42.158, "o", "\u001b[90m  13\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Requiere: wget, sha256sum, awk, stat. No instala nada.\u001b[39;49;00m\n"]
[42.213, "o", "\u001b[90m  14\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Idempotente: si la imagen ya existe y su SHA256 coincide, no descarga.\u001b[39;49;00m\n"]
