[72.628, "o", "\u001b[90m┌─ 04_install_tor.sh · instalación y servicio ──────────────────────────────────────────────────────────\u001b[0m\n"]
[72.628, "o", "\u001b[90m   2\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# =============================================================================\u001b[39;49;00m\n"]
[72.683, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# 04_install_tor.sh — Instalacion de Tor y hidden service v3 persistente\u001b[39;49;00m\n"]
[72.738, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# =============================================================================\u001b[39;49;00m\n"]
[72.793, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Se ejecuta con el router ya en OpenWrt, con Internet en la WAN y SSH listo.\u001b[39;49;00m\n"]
[72.848, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#\u001b[39;49;00m\n"]
[72.903, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Que hace:\u001b[39;49;00m\n"]
[72.958, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   1. Verifica Internet, espacio en /overlay y arquitectura.\u001b[39;49;00m\n"]
[73.013, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   2. opkg update + opkg install tor (idempotente).\u001b[39;49;00m\n"]
[73.068, "o", "\u001b[90m  10\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   3. Crea /etc/tor/hidden_service con permisos 700 y owner tor:tor.\u001b[39;49;00m\n"]
[73.123, "o", "\u001b[90m  11\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   4. Escribe /etc/tor/torrc con el mapeo onion:80 -> 127.0.0.1:8080.\u001b[39;49;00m\n"]
[73.178, "o", "\u001b[90m  12\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   5. Habilita y reinicia Tor; espera la address .onion y verifica bootstrap.\u001b[39;49;00m\n"]
[73.233, "o", "\u001b[90m  13\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   6. Guarda ONION_ADDRESS en config (no versionado).\u001b[39;49;00m\n"]
[73.288, "o", "\u001b[90m  14\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#\u001b[39;49;00m\n"]
[73.343, "o", "\u001b[90m  15\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Uso:\u001b[39;49;00m\n"]
[73.398, "o", "\u001b[90m  16\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   ./scripts/04_install_tor.sh [--force]\u001b[39;49;00m\n"]
[73.453, "o", "\u001b[90m  17\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#\u001b[39;49;00m\n"]
[73.508, "o", "\u001b[90m  18\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   --force   continua aunque el espacio libre sea bajo (< 700 KiB).\u001b[39;49;00m\n"]
[73.563, "o", "\u001b[90m  19\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#\u001b[39;49;00m\n"]
[73.618, "o", "\u001b[90m  20\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# No configura el servicio local (eso lo hace 05_deploy_uhttpd.sh).\u001b[39;49;00m\n"]
