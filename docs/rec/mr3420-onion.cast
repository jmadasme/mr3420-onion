[116.228, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00muci\u001b[90m \u001b[39;49;00m\u001b[96mset\u001b[39;49;00m\u001b[90m \u001b[39;49;00mwireless.\u001b[33m${\u001b[39;49;00m\u001b[91mRADIO\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m.disabled=\u001b[33m'0'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[116.283, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00muci\u001b[90m \u001b[39;49;00m\u001b[96mset\u001b[39;49;00m\u001b[90m \u001b[39;49;00mwireless.\u001b[33m${\u001b[39;49;00m\u001b[91mIFACE\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m=wifi-iface\u001b[90m\u001b[39;49;00m\n"]
[116.338, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00muci\u001b[90m \u001b[39;49;00m\u001b[96mset\u001b[39;49;00m\u001b[90m \u001b[39;49;00mwireless.\u001b[33m${\u001b[39;49;00m\u001b[91mIFACE\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m.device=\u001b[33m'${RADIO}'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[116.393, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00muci\u001b[90m \u001b[39;49;00m\u001b[96mset\u001b[39;49;00m\u001b[90m \u001b[39;49;00mwireless.\u001b[33m${\u001b[39;49;00m\u001b[91mIFACE\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m.network=\u001b[33m'lan'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[116.448, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00muci\u001b[90m \u001b[39;49;00m\u001b[96mset\u001b[39;49;00m\u001b[90m \u001b[39;49;00mwireless.\u001b[33m${\u001b[39;49;00m\u001b[91mIFACE\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m.mode=\u001b[33m'ap'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[116.503, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00muci\u001b[90m \u001b[39;49;00m\u001b[96mset\u001b[39;49;00m\u001b[90m \u001b[39;49;00mwireless.\u001b[33m${\u001b[39;49;00m\u001b[91mIFACE\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m.ssid=\u001b[33m'${WIFI_SSID}'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
