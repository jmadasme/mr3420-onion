[12.352, "o", "\u001b[90m┌─ 02_tftp_flash.sh · alcance del script ───────────────────────────────────────────────────────────────\u001b[0m\n"]
[12.352, "o", "\u001b[90m   2\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# =============================================================================\u001b[39;49;00m\n"]
[12.407, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# 02_tftp_flash.sh — Preparacion del TFTP recovery de U-Boot\u001b[39;49;00m\n"]
[12.462, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# =============================================================================\u001b[39;49;00m\n"]
[12.517, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Deja la notebook y el servidor TFTP listos para que el TL-MR3420 descargue\u001b[39;49;00m\n"]
[12.572, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# tp_recovery.bin al entrar en modo recovery. NO flashea por si solo: el\u001b[39;49;00m\n"]
[12.627, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# arranque en recovery requiere la accion fisica del usuario.\u001b[39;49;00m\n"]
[12.682, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#\u001b[39;49;00m\n"]
[12.737, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Que hace:\u001b[39;49;00m\n"]
[12.792, "o", "\u001b[90m  10\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   1. Verifica que firmware/tp_recovery.bin exista y tenga el SHA256 correcto.\u001b[39;49;00m\n"]
