[56.782, "o", "\u001b[90m  19\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m[\u001b[90m \u001b[39;49;00m-e\u001b[90m \u001b[39;49;00m/sys/bus/platform/drivers/ehci-platform/unbind\u001b[90m \u001b[39;49;00m];\u001b[90m \u001b[39;49;00m\u001b[94mthen\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[56.837, "o", "\u001b[90m  20\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[96mecho\u001b[39;49;00m\u001b[90m \u001b[39;49;00m101c0000.ehci\u001b[90m \u001b[39;49;00m>\u001b[90m \u001b[39;49;00m/sys/bus/platform/drivers/ehci-platform/unbind\u001b[90m \u001b[39;49;00m\u001b[94m2\u001b[39;49;00m>/dev/null\u001b[90m\u001b[39;49;00m\n"]
